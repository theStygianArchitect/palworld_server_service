[Unit]
Description=Palworld Operations Suite TLS Certificate Auto-Renewal
Documentation=https://github.com/theStygianArchitect/palworld_server_service
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=palmanager
Group=palmanager
WorkingDirectory=/opt/palworld-web-manager
ExecStart=/opt/palworld-web-manager/.venv/bin/python -m app.engine.tls_manager renew
StandardOutput=journal
StandardError=journal
