# Palworld Operations Suite Environment Configuration

# Server Administration & REST API
PALWORLD_ADMIN_PASSWORD=your_secure_admin_password
PALWORLD_REST_PORT=8212
PALWORLD_SERVER_NAME="Palworld Dedicated Server"
PALWORLD_SERVER_DOMAIN=yourdomain.duckdns.org

# Network & Host
PALWORLD_HOST_IP=127.0.0.1
PALWORLD_SERVICE_NAME=palworld.service

# File Paths & Logging
PALWORLD_INI_PATH=/home/steam/.steam/steam/steamapps/common/PalServer/Pal/Saved/Config/LinuxServer/PalWorldSettings.ini
PALWORLD_BACKUP_REPO_DIR=/var/lib/palmanager/backups
PALWORLD_BACKUP_DIR=/home/steam/Palworld_backups
PALWORLD_LOG_DIR=/var/log/palmanager

# DuckDNS Updater Credentials
DUCKDNS_DOMAIN=your_subdomain
DUCKDNS_TOKEN=your_duckdns_token

# Discord Notifications (Optional - Free Incoming Webhook)
# Obtain from: Discord Server Settings -> Integrations -> Webhooks -> New Webhook
PALWORLD_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token
